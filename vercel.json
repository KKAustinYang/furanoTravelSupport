{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/proxy?__path=:path*"
    }
  ],
  "functions": {
    "api/proxy.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/d/nts-training/:path*",
      "destination": "/d/voice-roleplay/:path*",
      "permanent": false
    }
  ]
}
