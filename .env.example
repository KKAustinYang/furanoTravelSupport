# Copy this file to .env.local and fill in real values. .env.local is gitignored.
# In Vercel, set these in Project → Settings → Environment Variables.

# Modellix key — SERVER-SIDE ONLY (no VITE_ prefix), so it is never sent to the browser.
# Used by the serverless proxy (api/[...path].js) and the Vite dev proxy.
MODELLIX_KEY=mdlx-4mnEtrP3Km9WGjrIrTKxykmZB7YfQ16A3nrmTloW5C4aAOWo

# EngageLab WebPush appkey (public, optional — leave empty to disable web push).
VITE_ENGAGELAB_APPKEY=993263f0a7094a5aa006b302

# GPTBots（QNAP サポートAI アシスタント）— チケット内容をエージェントへ渡すのに使う
# 値は Vercel の環境変数にも設定すること。VITE_ プレフィックスは付けない（ブラウザに出る）
GPTBOTS_API_KEY=
# 省略時は日本リージョン（https://api-jp.gptbots.ai）
GPTBOTS_ENDPOINT=

# チケット内容のメール送信（demos/QNAP/tickets.html）
# Gmail の場合は「アプリ パスワード」を発行して SMTP_PASS に入れる（通常のパスワードでは送れない）
SMTP_USER=
SMTP_PASS=
# 宛先。未設定なら aurora.mobile.developer@gmail.com
MAIL_TO=
# 既定は smtp.gmail.com / 465。他のSMTPを使う場合のみ設定
SMTP_HOST=
SMTP_PORT=
